# Copy this file to .env.local (for local development) and fill in real values.
# On Vercel, set these under Project Settings -> Environment Variables instead
# of committing them to a file.

# Your Warwick SU "Key Organisation" key for Warwick Law Society.
# Get this from the Membership API tool in your Warwick SU exec tools.
# Keep this secret - do not commit the real value or share it publicly.
WARWICK_SU_ORG_KEY=replace-with-your-organisation-key

# A long, random secret used to sign member login sessions (cookies).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
